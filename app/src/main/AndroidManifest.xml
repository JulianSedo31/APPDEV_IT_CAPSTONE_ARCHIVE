<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.appdev_buksu_it_capstone_archives"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppDev_BUKSU_IT_CAPSTONE_ARCHIVES"
        tools:targetApi="31">

        <!-- Intro screen (Launcher) -->
        <activity 
            android:name=".IntroActivity"
            android:exported="true"
            android:theme="@style/Theme.AppDev_BUKSU_IT_CAPSTONE_ARCHIVES.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login screen -->
        <activity 
            android:name=".LoginActivity" 
            android:exported="true"
            android:theme="@style/Theme.AppDev_BUKSU_IT_CAPSTONE_ARCHIVES.NoActionBar" />

        <!-- Main dashboard -->
        <activity 
            android:name=".MainActivity" 
            android:exported="true"
            android:theme="@style/Theme.AppDev_BUKSU_IT_CAPSTONE_ARCHIVES.NoActionBar" />

        <!-- Capstone detail screen -->
        <activity 
            android:name=".CapstoneDetailActivity" 
            android:exported="true"
            android:theme="@style/Theme.AppDev_BUKSU_IT_CAPSTONE_ARCHIVES.NoActionBar" />

    </application>

</manifest>
